# Local development only. Copy this file to .env and replace every
# replace-me value. Never commit the resulting .env file.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=blipark
POSTGRES_USER=blipark
POSTGRES_PASSWORD=replace-me-with-a-random-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Obtain these values from the TDX console. They may remain empty when sync
# is not being used, but never put real values in this example file.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_TIMEOUT_SECONDS=30
TDX_PAGE_SIZE=500
TDX_MAX_ATTEMPTS=4
